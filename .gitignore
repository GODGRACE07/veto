# Virtual environment
venv/
env/
ENV/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Environment variables / secrets -- never commit real keys
.env
.env.local
.streamlit/secrets.toml

# OS / editor cruft
.DS_Store
Thumbs.db
